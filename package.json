{
  "name": "odontotrust",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @odontotrust/web --filter @odontotrust/api dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint . && pnpm --filter @odontotrust/web lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @odontotrust/db db:migrate",
    "db:seed": "pnpm --filter @odontotrust/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
